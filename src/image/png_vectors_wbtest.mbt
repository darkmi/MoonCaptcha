///|
fn arrays_eq(a : FixedArray[Int], b : FixedArray[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i in 0..<a.length() {
    if a[i] != b[i] {
      return false
    }
  }
  true
}

///|
test "inflate node fixed huffman vector" {
  match zlib_decompress(vec_fixed_compressed()) {
    Ok(d) => assert_true(arrays_eq(d, vec_fixed_plain()))
    Err(e) => {
      println(e)
      assert_true(false)
    }
  }
}

///|
test "inflate node dynamic huffman vector" {
  match zlib_decompress(vec_dyn_compressed()) {
    Ok(d) => assert_true(arrays_eq(d, vec_dyn_plain()))
    Err(e) => {
      println(e)
      assert_true(false)
    }
  }
}

///|
test "inflate node stored vector" {
  match zlib_decompress(vec_stored_compressed()) {
    Ok(d) => assert_true(arrays_eq(d, vec_stored_plain()))
    Err(e) => {
      println(e)
      assert_true(false)
    }
  }
}

///|
test "png decode real photo crop" {
  match decode_png(vec_crop_png()) {
    Ok(img) => {
      assert_true(img.width == 32)
      assert_true(img.height == 16)
      assert_true(arrays_eq(img.rgba, vec_crop_rgba()))
    }
    Err(e) => {
      println(e)
      assert_true(false)
    }
  }
}

///|
test "png decode all filter types" {
  match decode_png(vec_filt_png()) {
    Ok(img) => {
      assert_true(img.width == 5)
      assert_true(img.height == 4)
      assert_true(arrays_eq(img.rgba, vec_filt_rgba()))
    }
    Err(e) => {
      println(e)
      assert_true(false)
    }
  }
}
